{% extends "modele.jinja" %}

{% block contenu %}

<div class="container mt-4 mb-5">

    <h1 class="mb-1">Gestion des commandes</h1>
    <p class="text-muted mb-4">
        Préparer vos commandes.
    </p>

    <div class="row g-4">

        <div class="col-md-4">
            <div class="card shadow-sm border-0 rounded-4 h-100">
                <div class="card-body p-4">

                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h3 class="card-title mb-0 fs-5">
                            <i class="bi bi-inbox text-warning me-2"></i>À réaliser
                        </h3>
                        <span id="compteur-attente"
                              class="badge text-bg-warning rounded-pill">1</span>
                    </div>

                    <div id="repas-a-realiser"
                         class="kanban-zone"
                         data-statut="attente"
                         style="min-height: 300px;">

                        <div class="card shadow-sm border-0 rounded-3 p-3 mb-3 kanban-carte"
                             data-id-commande="12">

                            <h5 class="mb-3">
                                <i class="bi bi-receipt me-2"></i>Commande #12
                            </h5>

                            <div class="d-flex justify-content-between mb-2">
                                <span><i class="bi bi-egg-fried me-2 text-muted"></i>Burger poulet</span>
                                <span class="text-muted">× 2</span>
                            </div>

                            <div class="d-flex justify-content-between">
                                <span><i class="bi bi-egg-fried me-2 text-muted"></i>Frites</span>
                                <span class="text-muted">× 1</span>
                            </div>

                        </div>

                    </div>
                </div>
            </div>
        </div>

        

</div>


<script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.6/Sortable.min.js"></script>

<script>
    const colonnes = document.querySelectorAll(".kanban-zone");

    colonnes.forEach(function(colonne) {

        new Sortable(colonne, {
            group: "commandes",
            animation: 150,
            draggable: ".kanban-carte"
        });

    });
</script>

{% endblock %}