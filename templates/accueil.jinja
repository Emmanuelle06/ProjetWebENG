{# Page d'accueil #}

{% extends "modele.jinja" %}

{% block contenu %}


<div class="bg-image-floue d-flex justify-content-center align-items-center min-vh-100">
    <div class="col-md-5 form-au-dessus">
        <div class="card shadow p-4 border-0 rounded-4 bg-light bg-opacity-75">

            <h2 class="text-center mb-4 fw-bold">Connexion</h2>

            <form method="POST" action="/">
                <div class="mb-3">
                    <label for="username" class="form-label">Nom d'utilisateur :</label>
                    <input type="text" id="username" name="username" class="form-control" required>
                </div>

                <div class="mb-3">
                    <label for="password" class="form-label">Mot de passe :</label>
                    <input type="password" id="password" name="password" class="form-control" required>
                </div>

                <div class="mb-4">
                    <label class="form-label d-block">Statut :</label>
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio" name="statut" id="acheteur" value="acheteur" checked>
                        <label class="form-check-label" for="acheteur">Acheteur</label>
                    </div>
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio" name="statut" id="vendeur" value="vendeur">
                        <label class="form-check-label" for="vendeur">Vendeur</label>
                    </div>
                </div>

                <button type="submit" class="btn btn-primary w-100 mb-3 py-2">Se connecter</button>
            </form>

            <hr class="my-4">

            <div class="text-center">
                <p class="text-muted mb-2">Vous n'avez pas de compte ?</p>
                <a href="#" class="btn btn-outline-primary w-100 mb-2">Créer compte Acheteur</a>
                <a href="#" class="btn btn-outline-primary w-100">Créer compte Vendeur</a>
            </div>

        </div>
    </div>
</div>

{% endblock %}