{% extends "modele.jinja" %}

{% block contenu %}

<div class="container mt-4 mb-5">

    <h1 class="mb-4">Bienvenue, {{ utilisateur["prenom"] }}</h1>

    <div class="row g-4">
        <div class="col-md-8">
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-body p-4">
                    <h3 class="card-title mb-3">Informations du compte</h3>
                    <p><strong>Nom d'utilisateur :</strong> {{ utilisateur["username"] }}</p>
                    <p><strong>Nom :</strong> {{ utilisateur["nom"] }}</p>
                    <p><strong>Prénom :</strong> {{ utilisateur["prenom"] }}</p>
                    <p><strong>Téléphone :</strong> {{ utilisateur["telephone"] }}</p>
                    <p><strong>Adresse :</strong> {{ utilisateur["adresse_postal"] }}</p>

                    <a href="/profil/modifier" class="btn btn-primary mt-2 me-2">
                        <i class="bi bi-pencil-square me-2"></i>Modifier mon profil
                    </a>

                    <button type="button" class="btn btn-danger mt-2"
                            data-bs-toggle="modal" data-bs-target="#modalSuppressionCompte">
                        <i class="bi bi-trash3 me-2"></i>Supprimer mon profil
                    </button>

                    <div class="modal fade" id="modalSuppressionCompte" tabindex="-1"
                        aria-labelledby="titreSuppressionCompte" aria-hidden="true">

                        <div class="modal-dialog modal-dialog-centered">
                            <div class="modal-content rounded-4 border-2 border-dark">

                                <div class="modal-header border-0 pb-0">
                                    <h5 class="modal-title fw-bold" id="titreSuppressionCompte">
                                        <i class="bi bi-exclamation-triangle me-2"></i>
                                        Supprimer mon compte
                                    </h5>

                                    <button type="button" class="btn-close"
                                            data-bs-dismiss="modal" aria-label="Fermer"></button>
                                </div>

                                <div class="modal-body">
                                    <p class="mb-1">
                                        Voulez-vous vraiment supprimer votre compte ?
                                    </p>
                                    <p class="text-secondary mb-0">
                                        Cette action est définitive.
                                    </p>
                                </div>

                                <div class="modal-footer border-0 pt-0">
                                    <button type="button" class="btn btn-secondary"
                                            data-bs-dismiss="modal">
                                        Annuler
                                    </button>

                                    <form method="post"
                                        action="{{ url_for('acheteur.supprimer_profil') }}">
                                        <button type="submit" class="btn btn-danger">
                                            <i class="bi bi-trash3 me-2"></i>
                                            Oui, supprimer
                                        </button>
                                    </form>
                                </div>

                            </div>
                        </div>
                    </div>


                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm border-0 rounded-4 h-100">
                <div class="card-body p-4 d-flex flex-column justify-content-between">
                    <div>
                        <h3 class="card-title mb-3">Carte de fidélité</h3>
                        <p class="mb-1 text-muted">Crédit disponible :</p>
                        <h2 class="text-success mb-3">{{ utilisateur["credit"] }} $</h2>
                    </div>
                    <form method="post" action="{{ url_for('acheteur.charger_carte') }}">
                        <div class="mb-3">
                            <label for="montant" class="form-label">Montant à ajouter ($) </label>
                            <input type="number" id="montant" name="montant" class="form-control w-75" min="1" max="500" required>
                        </div>

                        <button type="submit" class="btn btn-primary w-75">
                            Charger ma carte
                        </button>

                    </form>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-0 rounded-4 mt-4">
        <div class="card-body p-4">
            <h3 class="card-title mb-3">Historique de mes commandes</h3>
            <p class="text-muted mb-0">Aucune commande à afficher pour le moment.</p>
        </div>
    </div>
</div>

{% endblock %}