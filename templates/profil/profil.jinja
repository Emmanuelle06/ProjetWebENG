{% extends "modele.jinja" %}

{% block contenu %}

<div class="container mt-4 mb-5">

    <h1 class="mb-4">Bienvenue, {{ utilisateur["prenom"] }}</h1>

    <div class="row g-4">
        <div class="col-md-8">
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-body p-4">
                    <h3 class="card-title mb-3">Informations du compte</h3>
                    <p><strong>Nom d'utilisateur :</strong> {{ utilisateur["username"] }}</p>
                    <p><strong>Nom :</strong> {{ utilisateur["nom"] }}</p>
                    <p><strong>Prénom :</strong> {{ utilisateur["prenom"] }}</p>
                    <p><strong>Téléphone :</strong> {{ utilisateur["telephone"] }}</p>
                    <p><strong>Adresse :</strong> {{ utilisateur["adresse_postal"] }}</p>

                    <a href="/profil/modifier" class="btn btn-primary mt-2 me-2">
                        <i class="bi bi-pencil-square me-2"></i>Modifier mon profil
                    </a>

                    <button type="button" class="btn btn-danger mt-2"
                            data-bs-toggle="modal" data-bs-target="#modalSuppressionCompte">
                        <i class="bi bi-trash3 me-2"></i>Supprimer mon profil
                    </button>

                    <div class="modal fade" id="modalSuppressionCompte" tabindex="-1"
                        aria-labelledby="titreSuppressionCompte" aria-hidden="true">

                        <div class="modal-dialog modal-dialog-centered">
                            <div class="modal-content rounded-4 border-2 border-dark">

                                <div class="modal-header border-0 pb-0">
                                    <h5 class="modal-title fw-bold" id="titreSuppressionCompte">
                                        <i class="bi bi-exclamation-triangle me-2"></i>
                                        Supprimer mon compte
                                    </h5>

                                    <button type="button" class="btn-close"
                                            data-bs-dismiss="modal" aria-label="Fermer"></button>
                                </div>

                                <div class="modal-body">
                                    <p class="mb-1">
                                        Voulez-vous vraiment supprimer votre compte ?
                                    </p>
                                    <p class="text-secondary mb-0">
                                        Cette action est définitive.
                                    </p>
                                </div>

                                <div class="modal-footer border-0 pt-0">
                                    <button type="button" class="btn btn-secondary"
                                            data-bs-dismiss="modal">
                                        Annuler
                                    </button>

                                    <form method="post"
                                        action="{{ url_for('acheteur.supprimer_profil') }}">
                                        <button type="submit" class="btn btn-danger">
                                            <i class="bi bi-trash3 me-2"></i>
                                            Oui, supprimer
                                        </button>
                                    </form>
                                </div>

                            </div>
                        </div>
                    </div>


                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm border-0 rounded-4 h-100">
                <div class="card-body p-4 d-flex flex-column justify-content-between">
                    <div>
                        <h3 class="card-title mb-3">Carte de fidélité</h3>
                        <p class="mb-1 text-muted">Crédit disponible :</p>
                        <h2 class="text-success mb-3">{{ utilisateur["credit"]|round(2) }} $</h2>
                    </div>
                    <form method="post" action="{{ url_for('acheteur.charger_carte') }}">
                        <div class="mb-3">
                            <label for="montant" class="form-label">Montant à ajouter ($) </label>
                            <input type="number" id="montant" name="montant" class="form-control w-75" min="1" max="500" required>
                        </div>
                        <button type="submit" class="btn btn-primary w-75">Charger ma carte</button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-0 rounded-4 mt-4">
    <div class="card-body p-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h3 class="card-title mb-0">
                <i class="bi bi-receipt fs-3"></i> Historique de mes commandes
            </h3>
        </div>

        {% if commandes %}
            {% for commande in commandes %}
                <div class="card shadow-sm border-0 rounded-3 mb-3">
                    <div class="card-body p-3">

                        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
                            <h5 class="mb-0">Commande #{{ commande["id_commande"]}}</h5>

                            <span class="badge
                                {% if commande['statut'] == 'attente' %}
                                    text-bg-warning
                                {% elif commande['statut'] == 'cours' %}
                                    text-bg-primary
                                {% elif commande['statut'] == 'terminer' %}
                                    text-bg-success
                                {% else %}
                                    text-bg-secondary
                                {% endif %}">
                                {% if commande['statut'] == 'attente' %}
                                    En attente
                                {% elif commande['statut'] == 'cours' %}
                                    En cours
                                {% elif commande['statut'] == 'terminer' %}
                                    Terminée
                                {% endif %}
                            </span>
                        </div>

                        {% for repas in commande["repas"] %}
                            <a href="{{ url_for('menu.detail_repas', id_repas=repas['id_repas']) }}"
                               class="text-decoration-none text-dark">

                                <div class="d-flex align-items-center gap-3 mb-3">
                                    <img
                                        src="{{ url_for('vendeur.image_repas', id_repas=repas['id_repas']) }}"
                                        alt="{{ repas['nom'] }}" width="75" height="75" class="rounded-3" style="object-fit: cover; flex-shrink: 0;">
                                    <div class="flex-grow-1">
                                        <span class="fw-semibold">{{ repas["nom"] }}</span>

                                        <div class="text-muted small">
                                            Quantité : {{ repas["quantite"] }}
                                        </div>
                                    </div>

                                    <span class="fw-semibold text-nowrap">
                                        {{ (repas["prix"] * repas["quantite"])|round(2) }} $
                                    </span>
                                </div>
                            </a>
                        {% endfor %}

                        <hr>

                        <div class="d-flex justify-content-between align-items-center">
                            <span class="text-muted">Total</span>
                            <h5 class="mb-0">
                                {{ commande["cout_total"]|round(2) }} $
                            </h5>
                        </div>

                    </div>
                </div>
            {% endfor %}

        {% else %}
            <div class="text-center py-4">
                <i class="bi bi-basket display-4 text-muted"></i>
                <p class="text-muted mt-3 mb-3">
                    Aucune commande à afficher pour le moment.
                </p>
                <a href="{{ url_for('menu.menu') }}" class="btn btn-primary">
                    Découvrir le menu
                </a>
            </div>
        {% endif %}
    </div>
</div>

{% endblock %}