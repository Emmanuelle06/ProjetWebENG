{% extends "modele.jinja" %}

{% block contenu %}

<div class="container mt-4 mb-5">

    <h1 class="mb-4">Bienvenue chez {{ utilisateur["nom_restaurant"] }}</h1>

    <div class="row g-4">
        <div class="col-md-8">
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-body p-4">
                    <h3 class="card-title mb-3">Informations du compte</h3>
                    <p><strong>Nom d'utilisateur :</strong> {{ utilisateur["username"] }}</p>
                    <p><strong>Nom Restaurant:</strong> {{ utilisateur["nom_restaurant"] }}</p>
                    <p><strong>Téléphone :</strong> {{ utilisateur["telephone"] }}</p>
                    <p><strong>Adresse :</strong> {{ utilisateur["adresse_postale"] }}</p>

                    <a href="/profil/modifier" class="btn btn-primary mt-2 me-2">
                        <i class="bi bi-pencil-square me-2"></i>Modifier mon profil
                    </a>
                    <button type="button" class="btn btn-danger mt-2"
                        commandfor="dialogSuppression" command="show-modal">
                        <i class="bi bi-trash3 me-2"></i>Supprimer mon profil
                    </button>

                    <dialog id="dialogSuppression" class="rounded-4 border-2 border-dark p-4">
                        <h5 class="fw-bold mb-3">
                            <i class="bi bi-exclamation-triangle me-2"></i>Supprimer mon compte
                        </h5>

                        <p>Voulez-vous vraiment supprimer votre compte ? Cette action est définitive.</p>

                        <div class="d-flex justify-content-end gap-2">
                            <button type="button" class="btn btn-secondary"
                                    commandfor="dialogSuppression" command="close">
                                Annuler
                            </button>

                            <form method="post" action="{{ url_for('acheteur.supprimer_profil') }}">
                                <button type="submit" class="btn btn-danger">
                                    <i class="bi bi-trash3 me-2"></i>Oui, supprimer
                                </button>
                            </form>
                        </div>
                    </dialog>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-0 rounded-4 mt-4">
        <div class="card-body p-4">
            <h3 class="card-title mb-3">Historique de mes commandes</h3>
            <p class="text-muted mb-0">Aucune commande à afficher pour le moment.</p>
        </div>
    </div>
</div>

{% endblock %}