{% extends "modele.jinja" %}

{% block contenu %}

<div class="container mt-4 mb-5">

    <h1 class="mb-4">Bienvenue chez, {{ utilisateur["nom_restaurant"] }}</h1>

    <div class="row g-4">
        <div class="col-md-8">
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-body p-4">
                    <h3 class="card-title mb-3">Informations du compte</h3>
                    <p><strong>Nom d'utilisateur :</strong> {{ utilisateur["username"] }}</p>
                    <p><strong>Nom Restaurant:</strong> {{ utilisateur["nom_restaurant"] }}</p>
                    <p><strong>Téléphone :</strong> {{ utilisateur["telephone"] }}</p>
                    <p><strong>Adresse :</strong> {{ utilisateur["adresse_postale"] }}</p>

                    <a href="{{ url_for('vendeur.modifier_profil') }}" class="btn btn-primary mt-2 me-2">
                        <i class="bi bi-pencil-square me-2"></i>Modifier mon profil
                    </a>

                    <button type="button" class="btn btn-danger mt-2"
                            data-bs-toggle="modal"
                            data-bs-target="#modalSuppressionProfil">
                        <i class="bi bi-trash3 me-2"></i>Supprimer mon profil
                    </button>

                    <div class="modal fade" id="modalSuppressionProfil"
                        tabindex="-1" aria-labelledby="titreSuppressionProfil"
                        aria-hidden="true">

                        <div class="modal-dialog modal-dialog-centered">
                            <div class="modal-content rounded-4 border-2 border-dark">

                                <div class="modal-header border-0 pb-0">
                                    <h5 class="modal-title fw-bold" id="titreSuppressionProfil">
                                        <i class="bi bi-exclamation-triangle me-2"></i>
                                        Supprimer mon compte
                                    </h5>

                                    <button type="button" class="btn-close"
                                            data-bs-dismiss="modal" aria-label="Fermer"></button>
                                </div>

                                <div class="modal-body">
                                    Voulez-vous vraiment supprimer votre compte ?
                                    Cette action est définitive.
                                </div>

                                <div class="modal-footer border-0 pt-0">
                                    <button type="button" class="btn btn-secondary"
                                            data-bs-dismiss="modal">
                                        Annuler
                                    </button>

                                    <form method="post"
                                        action="{{ url_for('vendeur.supprimer_profil') }}">
                                        <button type="submit" class="btn btn-danger">
                                            <i class="bi bi-trash3 me-2"></i>
                                            Oui, supprimer
                                        </button>
                                    </form>
                                </div>

                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>



    <div class="card shadow-sm border-0 rounded-4 mt-4">
        <div class="card-body p-4">

            <div class="d-flex justify-content-between align-items-center mb-4">
                <h3 class="card-title mb-3">Historique de mes repas</h3>

            </div>

            {% if repas %}

                {% for plat in repas %}

                    <div class="card shadow-sm border-0 rounded-3 p-3 mb-3">
                        <div class="d-flex align-items-center gap-3">

                            <img
                                src="{{ url_for('vendeur.image_repas', id_repas=plat['id_repas']) }}"
                                alt="{{ plat['nom'] }}" width="100" height="100" style="object-fit: cover; flex-shrink: 0;">

                            <div class="flex-grow-1">
                                <h5>{{ plat['nom'] }}</h5>

                                <p class="text-muted mb-2">
                                    {{ plat['description'] }}
                                </p>

                                <p class="fw-bold mb-2">
                                    {{ "%.2f"|format(plat['prix']) }} $
                                </p>

                                {% if plat['disponibilite']|string|lower in ['1', 'true', 'on'] %}
                                    <span class="badge bg-success">Disponible</span>
                                {% else %}
                                    <span class="badge bg-secondary">Indisponible</span>
                                {% endif %}
                            </div>

                            <div class="d-flex flex-column gap-2">

                                <form method="post"
                                    action="{{ url_for('vendeur.changer_disponibilite', id_repas=plat['id_repas']) }}">

                                    {% if plat['disponibilite']|string|lower in ['1', 'true', 'on'] %}
                                        <button type="submit" class="btn btn-outline-secondary btn-sm"><i class="bi bi-eye-slash me-1"></i>Désactiver </button>
                                    {% else %}
                                        <button type="submit" class="btn btn-outline-success btn-sm"><i class="bi bi-eye me-1"> </i> Réactiver </button>
                                    {% endif %}

                                </form>
                                <a href="#" class="btn btn-outline-primary btn-sm">
                                    <i class="bi bi-pencil-square me-1"> </i>Modifier
                                </a>


                                <button type="button" class="btn btn-outline-danger btn-sm"
                                        data-bs-toggle="modal"
                                        data-bs-target="#modalSuppressionRepas{{ plat['id_repas'] }}">
                                    <i class="bi bi-trash3 me-1"></i> Supprimer
                                </button>

                                <div class="modal fade" id="modalSuppressionRepas{{ plat['id_repas'] }}"
                                    tabindex="-1"
                                    aria-labelledby="titreSuppression{{ plat['id_repas'] }}"
                                    aria-hidden="true">

                                    <div class="modal-dialog modal-dialog-centered">
                                        <div class="modal-content rounded-4 border-2 border-dark">

                                            <div class="modal-header border-0 pb-0">
                                                <h5 class="modal-title fw-bold"
                                                    id="titreSuppression{{ plat['id_repas'] }}">
                                                    <i class="bi bi-exclamation-triangle me-2"></i>
                                                    Supprimer ce repas
                                                </h5>

                                                <button type="button" class="btn-close"
                                                        data-bs-dismiss="modal" aria-label="Fermer"></button>
                                            </div>

                                            <div class="modal-body">
                                                <p class="mb-1">
                                                    Voulez-vous vraiment supprimer ce repas ?
                                                </p>
                                                <p class="fw-bold">{{ plat['nom'] }}</p>
                                            </div>

                                            <div class="modal-footer border-0 pt-0">
                                                <button type="button" class="btn btn-secondary"
                                                        data-bs-dismiss="modal">
                                                    Annuler
                                                </button>

                                                <form method="post"
                                                    action="{{ url_for('vendeur.supprimer_mon_repas', id_repas=plat['id_repas']) }}">
                                                    <button type="submit" class="btn btn-danger">
                                                        <i class="bi bi-trash3 me-1"></i>
                                                        Oui, supprimer
                                                    </button>
                                                </form>
                                            </div>

                                        </div>
                                    </div>
                                </div>


                            </div>
                        </div>
                    </div>

                {% endfor %}

            {% else %}

                <p class="text-muted mb-0">
                    Vous n'avez pas encore ajouté de repas.
                </p>

            {% endif %}

        </div>
    </div>

</div>
{% endblock %}