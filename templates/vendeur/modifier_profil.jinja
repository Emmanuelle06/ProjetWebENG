
{% extends "modele.jinja" %}

{% block contenu %}

<div class="container mt-4 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card border-0">
                <div class="card-body p-4">

                    <h1 class="text-center mb-4">Modifier mon profil</h1>

                    <form method="post" action="{{ url_for('vendeur.modifier_profil') }}" novalidate>

                        <div class="mb-3">
                            <label for="nom_utilisateur" class="form-label">
                                Nom d'utilisateur
                            </label>
                            <input type="text" name="nom_utilisateur"
                                   id="nom_utilisateur"
                                   value="{{ utilisateur['username'] }}"
                                   class="form-control {{ classe_nom_utilisateur|default('') }}">
                            {% if message_nom_utilisateur|default('') %}
                                <div class="invalid-feedback">
                                    {{ message_nom_utilisateur }}
                                </div>
                            {% endif %}
                        </div>

                        <div class="mb-3">
                            <label for="nom_restaurant" class="form-label">
                                Nom du restaurant
                            </label>
                            <input type="text" name="nom_restaurant"
                                   id="nom_restaurant"
                                   value="{{ utilisateur['nom_restaurant'] }}"
                                   class="form-control {{ classe_nom|default('') }}">
                            {% if classe_nom|default('') == 'is-invalid' %}
                                <div class="invalid-feedback">
                                    Veuillez saisir le nom du restaurant.
                                </div>
                            {% endif %}
                        </div>

                        <div class="mb-3">
                            <label for="telephone" class="form-label">
                                Téléphone
                            </label>
                            <input type="tel" name="telephone"
                                   id="telephone"
                                   value="{{ utilisateur['telephone'] }}"
                                   class="form-control {{ classe_telephone|default('') }}">
                            {% if classe_telephone|default('') == 'is-invalid' %}
                                <div class="invalid-feedback">
                                    Le téléphone doit contenir 10 chiffres.
                                </div>
                            {% endif %}
                        </div>

                        <div class="mb-3">
                            <label for="adresse" class="form-label">
                                Adresse postale
                            </label>
                            <input type="text" name="adresse"
                                   id="adresse"
                                   value="{{ utilisateur['adresse_postale'] }}"
                                   class="form-control {{ classe_adresse|default('') }}">
                            {% if classe_adresse|default('') == 'is-invalid' %}
                                <div class="invalid-feedback">
                                    Veuillez saisir une adresse.
                                </div>
                            {% endif %}
                        </div>

                        <hr class="my-4">

                        <h4 class="mb-3">Changer le mot de passe <small class="text-muted fs-6">(laisser vide si inchangé)</small></h4>

                        <div class="mb-3">
                            <label for="nouveau_mdp" class="form-label">Nouveau mot de passe</label>
                            <input type="password" name="nouveau_mdp" id="nouveau_mdp" class="form-control">
                        </div>

                        <div class="mb-3">
                            <label for="confirmation_mdp" class="form-label">Confirmer le nouveau mot de passe</label>
                            <input type="password" name="confirmation_mdp" id="confirmation_mdp" class="form-control">
                        </div>

                        <div class="d-flex justify-content-between mt-4">
                            <a href="{{ url_for('vendeur.profil') }}" class="btn btn-secondary">
                                <i class="bi bi-arrow-left me-2"></i>Annuler
                            </a>
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-check-lg me-2"></i>Enregistrer les modifications
                            </button>
                        </div>

                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

{% endblock %}
