<!DOCTYPE html>
<html lang="fr">

<head>
    <title>EatFast</title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="stylesheet" href="{{ url_for('static', filename='css/styles.css') }}">
    <link rel="stylesheet" href="{{ url_for('static', filename='css/custom.css') }}">
</head>


<body>

    <nav class="navbar navbar-expand-lg">
        <div class="container">

            <a class="navbar-brand nom-eatfast" href="{{ url_for('index') }}">
                EatFast
            </a>
            <div class="ms-auto d-flex gap-3">
                {% if session["statut"] == "vendeur" %}
                <a href="/vendeur/ajout-repas">Ajouter un repas</a>
                {% endif %}
                {% if session %}
                <a href="/deconnexion">Déconnexion</a>
                {% endif %}
            </div>
        </div>
    </nav>

    <main>

        {% block contenu %}

        {% endblock %}

    </main>

    <footer id="pied">

        <div class="d-flex justify-content-center">
            <p class="mb-0 text-center "> &copy; Glawdys & Emmanuelle & Noah </p>

        </div>
    </footer>
</body>


</html>