<!DOCTYPE html>
<html lang="fr">

<head>
    <title>EatFast</title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="stylesheet" href="{{ url_for('static', filename='css/styles.css') }}">
    <link rel="stylesheet" href="{{ url_for('static', filename='css/custom.css') }}">

</head>


<body>

    <nav class="navbar navbar-expand-lg">
        <div class="container">

            <a class="navbar-brand nom-eatfast" href="{{ url_for('index') }}">
                EatFast
            </a>

            <div class="ms-auto d-flex align-items-center gap-3">
                {% if session.id_utilisateur %}
                <a href="{{ url_for('menu') }}" class="nav-link">Menu</a>

                {% endif %}

                {% if session["statut"] == "vendeur" %}
                <form action="/vendeur/ajout-repas" method="GET" class="mb-0">
                    <input type="submit" value="Ajouter un repas" class="btn btn-primary">
                </form>
                {% endif %}

                {% if session.id_utilisateur %}
                <form action="/deconnexion" method="GET" class="mb-0">
                    <input type="submit" value="Déconnexion" class="btn btn-primary">
                </form>
                {% endif %}
                {% if session["statut"] == 'acheteur'%}
                <img src="{{ url_for('static', filename='images/panier.png') }}" alt="Panier"
                    style="width: 40px; cursor: pointer;" data-bs-toggle="offcanvas" data-bs-target="#offcanvasRight"
                    aria-controls="offcanvasRight">
                {% endif %}
            </div>
        </div>
    </nav>



    <div class="offcanvas offcanvas-end" tabindex="-1" id="offcanvasRight" aria-labelledby="offcanvasRightLabel">
        <div class="offcanvas-header">
            <h5 id="offcanvasRightLabel">Mon panier</h5>
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Fermer">
            </button>
        </div>

        <div class="offcanvas-body" id="panier">
            {% if "panier" in session%}
            {% for repas in session["panier"]%}
            <div class="d-flex border border-black m-1">
                <img src="{{ url_for('image_repas', id_repas=repas['id']) }}" style="width: 60px; height: 60px;"
                    alt="{{ repas['nom'] }}">
                <div style="width: 100%;">
                    <div class="d-flex justify-content-between">
                        <p class="fs-5 m-0"> {{repas.nom}} - {{repas.prix}} $</p>
                        <a href="/enlever-panier/{{ repas['id'] }}">
                            <img src="{{ url_for('static', filename='images/poubelle.png') }}" alt="poubelle"
                                style="width: 25px; height: 25px;"></a>


                    </div>
                    <p class="fs-5 m-0">Quantité : </p>
                </div>

            </div>
            {%endfor%}
            <p class="fs-5">Coût total :</p>
            <form method="post" action="/vider-panier">
                <button type="submit">Vider le panier</button>
            </form>
            <form method="post" action="/passer-commande">
                <button type="submit">Passer la comamnde</button>
            </form>
            {%endif%}
        </div>

    </div>
    <main>

        {% with messages = get_flashed_messages(with_categories=true) %}
        {% if messages %}
        <div class="container mt-3">
            {% for category, message in messages %}
            <div class="alert alert-{{ category }} text-center" role="alert">{{ message }}</div>
            {% endfor %}
        </div>
        {% endif %}
        {% endwith %}

        {% block contenu %}

        {% endblock %}

    </main>

    <footer id="pied">

        <div class="d-flex justify-content-center">
            <p class="mb-0 text-center "> &copy; Glawdys & Emmanuelle & Noah </p>

        </div>
    </footer>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
</body>


</html>