<!DOCTYPE html>
<html lang="fr">

<head>
    <title>EatFast</title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="{{ url_for('static', filename='css/styles.css') }}">
    <link rel="stylesheet" href="{{ url_for('static', filename='css/custom.css') }}">

</head>


<body>



    <nav class="navbar navbar-expand-lg">
        <div class="container">

            <a class="navbar-brand nom-eatfast" href="{{ url_for('index') }}">
                EatFast
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menuNavigation"
                aria-controls="menuNavigation" aria-expanded="false" aria-label="Ouvrir le menu">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="menuNavigation">

                <div class="navbar-nav mx-auto align-items-lg-center gap-lg-3">

                    {% if session.id_utilisateur %}
                    <a href="{{ url_for('menu.menu') }}" class="nav-link">Menu</a>
                    {% endif %}

                    {% if session.get("statut") == "vendeur" %}
                    <a href="/vendeur/ajout-repas" class="btn btn-primary">Ajouter un repas</a>
                    {% endif %}
                </div>

                <div class="navbar-nav ms-auto align-items-lg-center gap-lg-3">
                    {% if session.get("statut") == "acheteur" %}
                    <a href="{{ url_for('acheteur.profil') }}" class="nav-link d-flex align-items-center gap-2">
                        <img src="{{ url_for('static', filename='images/' + session.get('avatar', 'avatar.jpg')) }}"
                            class="avatar" alt="Avatar">
                        <span>{{ session["username"] }}</span>
                    </a>
                    {% endif %}

                    {% if session.get("statut") == "vendeur" %}
                    <a href="{{ url_for('vendeur.profil') }}" class="nav-link d-flex align-items-center gap-2">
                        <img src="{{ url_for('static', filename='images/' + session.get('avatar', 'avatar.jpg')) }}"
                            class="avatar" alt="Avatar">
                        <span>{{ session["username"] }}</span>
                    </a>
                    {% endif %}

                    {% if session.id_utilisateur %}
                    <a href="/deconnexion" class="btn btn-primary">Déconnexion</a>
                    {% endif %}

                    {% if session.get("statut") == "acheteur" %}
                    <img src="{{ url_for('static', filename='images/panier.png') }}" alt="Panier"
                        style="width: 40px; cursor: pointer;" data-bs-toggle="offcanvas"
                        data-bs-target="#offcanvasRight" aria-controls="offcanvasRight">
                    {% endif %}
                </div>

            </div>
        </div>
    </nav>




    <div class="offcanvas offcanvas-end" tabindex="-1" id="offcanvasRight" aria-labelledby="offcanvasRightLabel">
        <div class="offcanvas-header">
            <h5 id="offcanvasRightLabel">Mon panier</h5>
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Fermer">
            </button>
        </div>

        <div class="offcanvas-body" id="panier">
            {% if "panier" in session%}
            {% for repas in session["panier"]%}
            <div class="d-flex m-2 carte-repas gap-2 m-3">
                <img src="{{ url_for('image_repas', id_repas=repas['id']) }}" style="width: 60px; height: 60px;"
                    alt="{{ repas['nom'] }}">
                <div style="width: 100%;">
                    <div class="d-flex justify-content-between">
                        <p class="fs-5 m-0"> {{repas.nom}} - {{repas.prix}} $</p>
                        <a href="/enlever-panier/{{ repas['id'] }}">
                            <img src="{{ url_for('static', filename='images/poubelle.png') }}" alt="poubelle"
                                style="width: 20px; height: 20px;"></a>
                    </div>
                    <div class="d-flex gap-3 align-items-center">
                        <p class="fs-5 m-0">{{repas.nom_resto}}</p>
                        <form method="POST" action="/modifier-quantite/{{repas['id']}}"
                            class="d-flex gap-2 align-items-center">
                            <div class="d-flex gap-2 rounded-pill btn-panier">
                                <button type="submit" name="action" value="moins" class=" btn-sm">-</button>
                                <p class="fs-5 m-0">{{repas.quantite}}</p>
                                <button type="submit" name="action" value="plus" class=" btn-sm">+</button>
                            </div>
                        </form>
                    </div>

                </div>
            </div>
            {%endfor%}
            {% if session["panier"] != []%}
            <p class="fs-5 fw-bold">Coût total : {{session["cout"]}} $</p>
            <div class="d-flex justify-content-between align-item-center">
                <form method="post" action="/vider-panier">
                    <button type="submit" class="btn btn-primary">Vider le panier</button>
                </form>
                <form method="post" action="/passer-commande">
                    <button type="submit" class="btn btn-primary">Passer la comamnde</button>
                </form>
            </div>
            {%endif%}
            {%endif%}
        </div>

    </div>
    <main>

        {% with messages = get_flashed_messages(with_categories=true) %}
        {% if messages %}
        <div class="container mt-3">
            {% for category, message in messages %}
            <div class="alert alert-{{ category }} text-center" role="alert">{{ message }}</div>
            {% endfor %}
        </div>
        {% endif %}
        {% endwith %}

        {% block contenu %}

        {% endblock %}

    </main>

    <footer id="pied">

        <div class="d-flex justify-content-center">
            <p class="mb-0 text-center "> &copy; Glawdys & Emmanuelle & Noah </p>

        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>


</html>